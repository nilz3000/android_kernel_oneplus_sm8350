BRANCH=android11-5.4
KMI_GENERATION=2

LLVM=1
CLANG_PREBUILT_BIN=clang/bin
DEPMOD=depmod
BUILDTOOLS_PREBUILT_BIN=build/kernel/build-tools/path/linux-x86

KCFLAGS="${KCFLAGS} -D__ANDROID_COMMON_KERNEL__"
STOP_SHIP_TRACEPRINTK=1
IN_KERNEL_MODULES=1
DO_NOT_STRIP_MODULES=0

SKIP_VENDOR_BOOT=1
LZ4_RAMDISK=1
KMI_ENFORCED=0
KMI_SYMBOL_LIST_STRICT_MODE=0
TRIM_NONLISTED_KMI=0
BUILD_DTBO_IMG=1
BUILD_GKI_CERTIFICATION_TOOLS=0
BUILD_INITRAMFS=0
MKDTIMG_FLAGS="--page_size=4096"

LTO=thin
#LTO=none
#FAST_BUILD=1
